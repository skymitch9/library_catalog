{
  "name": "library-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private catalog of our physical books and ebooks — works, editions, copies, read-state. Sibling to audiobook_catalog; shares its Google identity and reviews.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n worker,web -c blue,green \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "npm run dev --workspace @lc/worker",
    "dev:web": "npm run dev --workspace @lc/web",
    "prebuild": "node scripts/sync-universes.mjs && node scripts/sync-estate-auth.mjs && node scripts/sync-estate-theme.mjs && node scripts/sync-estate-search.mjs",
    "build": "npm run build --workspace @lc/web",
    "predeploy": "node scripts/check-clean.mjs && node scripts/deploy-guard.mjs",
    "deploy": "npm run build && npm run deploy --workspace @lc/worker",
    "postdeploy": "node scripts/deploy-done.mjs",
    "predeploy:friend": "node scripts/check-clean.mjs && node scripts/deploy-guard.mjs --instance=friend",
    "deploy:friend": "npm run build && npm run deploy:friend --workspace @lc/worker",
    "postdeploy:friend": "node scripts/deploy-done.mjs --instance=friend",
    "secret": "wrangler secret put --config apps/worker/wrangler.toml",
    "secret:list": "wrangler secret list --config apps/worker/wrangler.toml",
    "secret:friend": "wrangler secret put --config apps/worker/wrangler.toml --env friend",
    "secret:list:friend": "wrangler secret list --config apps/worker/wrangler.toml --env friend",
    "secrets:push:friend": "node scripts/push-secrets.mjs --env friend",
    "db:create": "wrangler d1 create library-catalog",
    "db:migrate:local": "npm run db:migrate:local --workspace @lc/worker",
    "db:migrate": "npm run db:migrate --workspace @lc/worker",
    "db:migrate:friend": "npm run db:migrate:friend --workspace @lc/worker",
    "pretypecheck": "node scripts/sync-universes.mjs && node scripts/sync-estate-auth.mjs && node scripts/sync-estate-theme.mjs && node scripts/sync-estate-search.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "node scripts/sync-universes.mjs && node scripts/sync-estate-auth.mjs && node scripts/sync-estate-theme.mjs && node scripts/sync-estate-search.mjs",
    "test": "tsx --test packages/core/test/*.test.ts packages/isbn/test/*.test.ts packages/estate-auth/test/*.test.ts packages/db/test/*.test.ts apps/worker/src/lib/*.test.ts apps/worker/src/routes/*.test.ts apps/web/test/*.test.ts",
    "universes:sync": "node scripts/sync-universes.mjs",
    "estate-auth:sync": "node scripts/sync-estate-auth.mjs",
    "estate-theme:sync": "node scripts/sync-estate-theme.mjs",
    "estate-search:sync": "node scripts/sync-estate-search.mjs",
    "backfill:reviews": "tsx scripts/backfill-review-keys.mjs",
    "backfill:read-states": "tsx scripts/backfill-read-from-ratings.mjs",
    "secrets:push": "node scripts/push-secrets.mjs",
    "import:ebooks": "tsx scripts/import-ebooks.mjs",
    "import:crowdfunding": "tsx scripts/import-crowdfunding.mjs",
    "backfill:covers": "tsx scripts/backfill-covers.mjs",
    "backfill:series": "tsx scripts/backfill-series.mjs",
    "backfill:series-volumes": "tsx scripts/backfill-series-volumes.mjs",
    "backfill:audiobooks": "tsx scripts/backfill-audiobook-holdings.mjs",
    "backfill:ebooks": "tsx scripts/backfill-ebook-holdings.mjs",
    "backfill:openlibrary-ids": "tsx scripts/backfill-openlibrary-ids.mjs",
    "backfill:missing-covers": "tsx scripts/backfill-missing-covers.mjs",
    "backfill:edition-kinds": "tsx scripts/backfill-edition-kinds.mjs",
    "backfill:universes": "tsx scripts/backfill-universes.mjs",
    "backfill:omnibus": "node scripts/backfill-omnibus-collects.mjs",
    "seed:audiobook-aliases": "tsx scripts/seed-audiobook-aliases.mjs",
    "sync:drive-map": "node scripts/sync-drive-map.mjs",
    "seed:verdicts": "node scripts/seed-gap-verdicts.mjs",
    "backfill:years": "tsx scripts/backfill-years.mjs",
    "apply:findings": "tsx scripts/apply-pending-findings.mjs",
    "audit:series-aggregates": "tsx scripts/audit-series-aggregates.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
