# Local development, and the SINGLE SOURCE OF TRUTH for production secrets.
#
# Edit a key here, then:   npm run secrets:push
#
# That pushes every allowlisted key to the deployed Worker over stdin, so a value
# never reaches argv, a process listing, or your shell history. One place to
# change a key — which is the point.
#
# ⚠️ This file is gitignored and must stay that way. It is the only file in the
# repo that holds real key material.

# --- local only, never pushed ------------------------------------------------

# Must not be "production", or DEV_EMAIL is ignored. That guard is what stops a
# stray value bypassing Google sign-in on the real site.
ENVIRONMENT = "development"

# Stands in for the Google identity Firebase supplies. Use your REAL address:
# `email` is the join key to the audiobook catalog, so a placeholder creates a
# local account that will not be you.
DEV_EMAIL = "you@example.com"
DEV_NAME = "Your Name"

# --- pushed to production by `npm run secrets:push` --------------------------

# Google Books, ISBN ladder rung 2. Free.
#
# ⚠️ Not optional in the way it looks: anonymous Google Books returned HTTP 429
# on 40 of 40 calls (2026-08-09), so without a key that rung never answers at
# all — it is skipped, with the reason in the scan trace.
#
# Use a key restricted to Books API only, on project 68492219785. Do NOT reuse
# the Firebase web key: it ships to every browser on the audiobook site, and
# restricting it to Books would break sign-in. See docs/access/cloudflare.md.
GOOGLE_BOOKS_API_KEY = ""

# Anthropic, for the research pipeline (phase 5, not built yet).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY = ""
