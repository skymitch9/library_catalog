# Copy to `.env` (gitignored) before `docker compose -f docker-compose.ebooks.yml up`.
#
# Only the ebook pipeline reads this. The Worker's own configuration lives in
# apps/worker/wrangler.toml (public vars) and `wrangler secret` (secrets).

# ---- Shared ----------------------------------------------------------------
TZ=America/Phoenix
# Where the Calibre library, CWA config and the ingest folders live. Gitignored.
EBOOK_DATA_DIR=./runtime/ebooks

# ---- Calibre-Web Automated -------------------------------------------------
# Localhost only. Do not publish this to the LAN without deciding to.
CWA_PORT=8083
PUID=1000
PGID=1000
# ⚠️ Set to true ONLY if the library lives on NFS/SMB. It changes SQLite and
# file-watching behaviour, and CWA's docs are explicit that the wrong value here
# produces a library that looks fine and silently misses ingests.
CWA_NETWORK_SHARE_MODE=false

# ---- Ingest watcher --------------------------------------------------------
# A file must be this old AND unchanged before it is moved into CWA's watched
# folder. Lifted from the audiobook pipeline: a downloader that is still writing
# looks exactly like one that has stopped.
MIN_FILE_AGE_SECONDS=300
EBOOK_POLL_INTERVAL_SECONDS=60

# ---- Indexer ---------------------------------------------------------------
LIBRARY_API_BASE=https://library-catalog.bgc-worker.workers.dev
# Must match the Worker secret: `npm run secret EBOOK_INGEST_TOKEN`.
# Generate with: openssl rand -hex 32
LIBRARY_API_TOKEN=

# ⚠️ 1 means the indexer reads the Calibre library and prints what it WOULD
# publish, writing nothing. Leave it at 1 until you have run
# `python scripts/index_cwa_library.py --audit` and read the keys it produced.
EBOOK_SYNC_DRY_RUN=1
